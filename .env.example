# Copy this file to ".env" for local testing with `netlify dev`.
# On the live site, set these same names in Netlify instead
# (Site configuration > Environment variables). Never commit a real .env file.

# Claude API key for the chat assistant — from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Resend API key for booking emails — from https://resend.com
RESEND_API_KEY=

# Where booking requests are emailed (Mike's inbox)
NOTIFY_EMAIL=

# The "from" address on booking emails. Must be on a domain verified in Resend.
# Leave blank to use Resend's test sender while you set things up.
FROM_EMAIL=
